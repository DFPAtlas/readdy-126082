# ============================================================================
# DFP Command — gitignore
# ============================================================================

# Environment / secrets — never commit real values. Example files with
# placeholder-only content (.env.example / .env.template) are intentionally
# tracked so developers know which variables are expected.
.env
.env.local
.env.production
.env.staging
.env.*.local
.env.*.production
.env.*.staging

# Local runtime bridge secrets (real values only; .env.example is tracked).
runtime-bridge/.env

# Private keys / certificates
*.pem
*.key
*.p12
*.pfx

# Dependencies / build output
node_modules/
dist/
dist-ssr/
*.local

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
*.log
npm-debug.log*