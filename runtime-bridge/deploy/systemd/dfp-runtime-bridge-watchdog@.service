[Unit]
Description=Check DFP runtime bridge liveness (%i)
After=dfp-runtime-bridge@%i.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
Environment=DFP_BRIDGE_LIVENESS_FILE=/run/dfp-runtime-bridge/%i.alive
Environment=DFP_BRIDGE_WATCHDOG_MAX_AGE_SECONDS=3
EnvironmentFile=-/etc/dfp/runtime-bridge/%i.env
ExecStart=/bin/sh /opt/dfp/runtime-bridge/deploy/systemd/watchdog.sh dfp-runtime-bridge@%i.service
