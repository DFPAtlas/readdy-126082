# ============================================================================
# dfp-runtime-bridge — example environment (VARIABLE NAMES ONLY — no secrets).
# Copy to `.env` and fill in your own values. Never commit real values.
# ============================================================================

# The full HTTPS URL of the DFP `runtime-bridge` Edge Function.
# Example: https://<project-ref>.supabase.co/functions/v1/runtime-bridge
DFP_BRIDGE_ENDPOINT=

# Per-node service identity. HAL and TRON must never share an identity or secret.
# HAL:  dfp-runtime-hal
# TRON: dfp-runtime-tron
DFP_BRIDGE_IDENTITY=

# Per-node HMAC signing secret. It must match the identity credential reference
# in Supabase (HAL or TRON). Never commit or reuse it.
DFP_BRIDGE_SIGNING_SECRET=

# Stable key + display name for this bridge node.
DFP_BRIDGE_NODE_KEY=
DFP_BRIDGE_NODE_NAME=

# Local n8n instance URL (local network only — never exposed publicly).
# Example: http://127.0.0.1:5678
N8N_LOCAL_URL=

# Fixed local n8n webhook path for the dedicated "DFP Runtime Sandbox Ping"
# diagnostic workflow (Prompt 12 sandbox probe). Must be a local /webhook/ path
# (e.g. /webhook/dfp-runtime-sandbox-ping) — NEVER an absolute URL, hostname, or
# protocol. Fail-closed when unset/invalid — the sandbox probe reports
# "workflow_not_configured" and never executes anything.
N8N_SANDBOX_WEBHOOK_PATH=/webhook/dfp-runtime-sandbox-ping

# Local Ollama instance URL (local network only — never exposed publicly).
# Example: http://127.0.0.1:11434
OLLAMA_LOCAL_URL=

# Local Atlas TRON RAG API URL (systemd atlas-rag-api.service, bound to TRON on
# port 8100 — local network only, never exposed publicly). The bridge calls
# GET /health only; it never calls /search, /api/embed, or any retrieval path.
# Example: http://127.0.0.1:8100
RAG_LOCAL_URL=

# Outbound heartbeat + control-message polling cadence (seconds).
HEARTBEAT_INTERVAL_SECONDS=60
POLL_INTERVAL_SECONDS=30

# Bound every cloud and local health request so one stuck socket cannot stop
# heartbeats indefinitely. Accepted range: 1000–60000 ms.
DFP_BRIDGE_REQUEST_TIMEOUT_MS=15000

# Process-liveness marker for the source-controlled watchdog. Use one unique file
# per node; the systemd template defaults to /run/dfp-runtime-bridge/<node>.alive.
# DFP_BRIDGE_LIVENESS_FILE=/run/dfp-runtime-bridge/hal.alive
DFP_BRIDGE_LIVENESS_INTERVAL_SECONDS=1
