# ============================================================================
# dfp-runtime-bridge — example environment (VARIABLE NAMES ONLY — no secrets).
# Copy to `.env` and fill in your own values. Never commit real values.
# ============================================================================

# The full HTTPS URL of the DFP `runtime-bridge` Edge Function.
# Example: https://<project-ref>.supabase.co/functions/v1/runtime-bridge
DFP_BRIDGE_ENDPOINT=

# The allowlisted bridge service identity (normally unchanged).
DFP_BRIDGE_IDENTITY=dfp-local-runtime-bridge

# The HMAC signing secret. MUST match the DFP_RUNTIME_BRIDGE_SIGNING_KEY value
# stored in Supabase Edge Function Secrets (server-side only). Never shared.
DFP_BRIDGE_SIGNING_SECRET=

# Stable key + display name for this bridge node.
DFP_BRIDGE_NODE_KEY=
DFP_BRIDGE_NODE_NAME=

# Local n8n instance URL (local network only — never exposed publicly).
# Example: http://127.0.0.1:5678
N8N_LOCAL_URL=

# Fixed local n8n webhook path for the dedicated "DFP Runtime Sandbox Ping"
# diagnostic workflow (Prompt 12 sandbox probe). Must be a local /webhook/ path
# (e.g. /webhook/dfp-runtime-sandbox-ping) — NEVER an absolute URL, hostname, or
# protocol. Fail-closed when unset/invalid — the sandbox probe reports
# "workflow_not_configured" and never executes anything.
N8N_SANDBOX_WEBHOOK_PATH=/webhook/dfp-runtime-sandbox-ping

# Local Ollama instance URL (local network only — never exposed publicly).
# Example: http://127.0.0.1:11434
OLLAMA_LOCAL_URL=

# Outbound heartbeat + control-message polling cadence (seconds).
HEARTBEAT_INTERVAL_SECONDS=60
POLL_INTERVAL_SECONDS=30